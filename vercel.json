{
  "redirects": [
    {
      "source": "/(.*)\\.sql",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.txt",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/informe",
      "destination": "/api/informe"
    },
    {
      "source": "/socios",
      "destination": "/api/informe?tipo=socios"
    },
    {
      "source": "/informes",
      "destination": "/api/informe?vista=todos"
    },
    {
      "source": "/:pagina",
      "destination": "/:pagina.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/reporte-incidencias.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/informe.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "crons": [
    {
      "path": "/api/calendario?fichas=1",
      "schedule": "0 13 * * *"
    }
  ]
}
